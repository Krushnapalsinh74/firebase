{
  "hosting": {
    "public": "artifacts/yunora-admin/dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "pnpm -C artifacts/yunora-admin run build"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "artifacts/api-server/dist",
    "runtime": "nodejs22",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.map"
    ],
    "environmentVariables": {
      "FIRESTORE_DATABASE_ID": "kp73"
    },
    "predeploy": [
      "pnpm -C artifacts/api-server run build",
      "node predeploy.mjs"
    ]
  }
}
