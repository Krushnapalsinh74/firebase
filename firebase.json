{
  "hosting": {
    "site": "kpark-edu",
    "public": "artifacts/kpark-admin/dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api",
        "region": "asia-south1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "artifacts/api-server/dist",
    "runtime": "nodejs22",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.map"
    ],
    "environmentVariables": {
      "FIRESTORE_DATABASE_ID": "kp73"
    }
  }
}